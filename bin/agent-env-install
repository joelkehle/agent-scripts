#!/usr/bin/env bash
set -euo pipefail

prefix="/usr/local/bin"
dry_run=0
use_sudo=0
verify=0
manifest_name=".agent-env-manifest.tsv"

usage() {
  cat <<'USAGE'
Usage: agent-env-install [--prefix DIR] [--sudo] [--dry-run] [--verify]

Materializes a self-contained coding-agent tool set as regular files.
Use --verify to check the installed files against their SHA256 manifest.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --prefix) [ "$#" -ge 2 ] || { printf 'agent-env-install: --prefix requires a directory\n' >&2; exit 2; }; prefix="$2"; shift 2 ;;
    --sudo) use_sudo=1; shift ;;
    --dry-run) dry_run=1; shift ;;
    --verify) verify=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'agent-env-install: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  self_dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
script_dir="$(cd -P "$(dirname "$self")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
manifest="$prefix/$manifest_name"

run_privileged() {
  printf 'agent-env-install:'
  printf ' %q' "$@"
  printf '\n'
  [ "$dry_run" -eq 1 ] && return 0
  if [ "$use_sudo" -eq 1 ]; then sudo -n "$@"; else "$@"; fi
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}';
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}

verify_install() {
  [ -f "$manifest" ] && [ ! -L "$manifest" ] || {
    printf 'agent-env-install: MISSING %s\n' "$manifest_name" >&2
    return 1
  }
  local failures=0 kind expected path actual
  while IFS=$'\t' read -r kind expected path; do
    [ "$kind" = "file" ] || continue
    if [ ! -f "$prefix/$path" ] || [ -L "$prefix/$path" ]; then
      printf 'agent-env-install: MISSING %s\n' "$path" >&2
      failures=1
      continue
    fi
    actual="$(sha256_file "$prefix/$path")"
    if [ "$actual" != "$expected" ]; then
      printf 'agent-env-install: CHANGED %s\n' "$path" >&2
      failures=1
    fi
  done < "$manifest"
  [ "$failures" -eq 0 ] || return 1
  printf 'agent-env-install: verification passed for %s\n' "$prefix"
}

if [ "$verify" -eq 1 ]; then
  [ "$dry_run" -eq 0 ] || { printf 'agent-env-install: --verify and --dry-run cannot be combined\n' >&2; exit 2; }
  verify_install
  exit
fi

commands=(
  agent-check agent-env-install agent-focus agent-start agent-workspace agentcoord
  bus-discover codex-bg committer contributor-agent csub dirty-audit docs-list
  install-claude-agents loop-audit loop-receipt loop-resume workspace-preflight
  trash
)

payload_paths=()
for command in "${commands[@]}"; do
  payload_paths+=("bin/$command")
done
while IFS= read -r relative; do
  payload_paths+=("$relative")
done < <(git -C "$repo_root" ls-files 'lib/**' 'workspace-roots/projects/.agents/**' | LC_ALL=C sort)

source_revision="$(git -C "$repo_root" rev-parse HEAD)"
if ! git -C "$repo_root" diff --quiet "$source_revision" -- "${payload_paths[@]}"; then
  printf 'agent-env-install: REFUSING tracked or staged payload changes; commit them first\n' >&2
  exit 1
fi

if [ -L "$prefix" ]; then
  printf 'agent-env-install: REFUSING install root symlink: %s\n' "$prefix" >&2
  exit 1
fi
run_privileged install -d -m 755 "$prefix"

# Directory links can hide writes outside the install root. Old command-file
# links are safe to replace and are migrated below.
for directory in bin lib workspace-roots workspace-roots/projects workspace-roots/projects/.agents; do
  if [ -L "$prefix/$directory" ]; then
    printf 'agent-env-install: REFUSING directory symlink in install root: %s\n' "$prefix/$directory" >&2
    exit 1
  fi
done

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/agent-env-install.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT
stage="$tmp_dir/payload"
install -d -m 755 "$stage/bin" "$stage/lib" "$stage/workspace-roots/projects/.agents"

normalized_mode() {
  local relative="$1" git_mode
  case "$relative" in
    bin/*|agent-check|agent-env-install|agent-focus|agent-start|agent-workspace|agentcoord|bus-discover|codex-bg|committer|contributor-agent|csub|dirty-audit|docs-list|install-claude-agents|loop-audit|loop-receipt|loop-resume|workspace-preflight|trash)
      printf '755\n'
      return
      ;;
  esac
  git_mode="$(git -C "$repo_root" ls-files -s -- "$relative" | awk 'NR == 1 { print $1 }')"
  if [ "$git_mode" = "100755" ]; then printf '755\n'; else printf '644\n'; fi
}

copy_regular() {
  local source="$1" destination="$2" relative="$3"
  [ -f "$source" ] && [ ! -L "$source" ] || {
    printf 'agent-env-install: source is not a regular file: %s\n' "$source" >&2
    exit 1
  }
  install -d -m 755 "$(dirname "$destination")"
  install -m "$(normalized_mode "$relative")" "$source" "$destination"
}

for command in "${commands[@]}"; do
  copy_regular "$repo_root/bin/$command" "$stage/bin/$command" "bin/$command"
  cat > "$stage/$command" <<LAUNCHER
#!/usr/bin/env sh
set -eu
install_root=\$(CDPATH= cd -- "\$(dirname -- "\$0")" && pwd -P)
exec "\$install_root/bin/$command" "\$@"
LAUNCHER
  chmod 755 "$stage/$command"
done

for relative in "${payload_paths[@]}"; do
  case "$relative" in bin/*) continue ;; esac
  copy_regular "$repo_root/$relative" "$stage/$relative" "$relative"
done

stage_manifest="$tmp_dir/$manifest_name"
{
  printf 'source_revision\t%s\n' "$source_revision"
  while IFS= read -r file; do
    relative="${file#"$stage/"}"
    printf 'file\t%s\t%s\n' "$(sha256_file "$file")" "$relative"
  done < <(find "$stage" -type f -print | LC_ALL=C sort)
} > "$stage_manifest"
chmod 644 "$stage_manifest"

if [ "$dry_run" -eq 1 ]; then
  printf 'agent-env-install: would materialize %s regular files into %s\n' "$(find "$stage" -type f | wc -l)" "$prefix"
  exit
fi

while IFS= read -r file; do
  relative="${file#"$stage/"}"
  run_privileged install -d -m 755 "$(dirname "$prefix/$relative")"
  run_privileged install -m "$(normalized_mode "$relative")" "$file" "$prefix/$relative"
done < <(find "$stage" -type f -print | LC_ALL=C sort)
run_privileged install -m 644 "$stage_manifest" "$manifest"

verify_install
printf 'agent-env-install: installed regular-file payload into %s\n' "$prefix"
printf 'agent-env-install: source revision %s\n' "$source_revision"

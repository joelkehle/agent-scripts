#!/usr/bin/env node

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const {
  SAFETY,
  normalizeRepo,
  normalizeTimestamp,
  parseTimestamp,
  prepareClaimForWrite,
  readClaim,
  readClaims,
} = require("../lib/agentcoord-claims");

const DEFAULT_ROOT = "/mnt/synology-share1/AgentCoord";

function usage() {
  console.log(`Usage:
  agentcoord list [--root DIR] [--all|--active|--stale|--invalid|--released] [--repo REPO] [--json]
  agentcoord validate [--root DIR] [--json]
  agentcoord claim --repo REPO --slug SLUG [options]
  agentcoord renew --repo REPO --slug SLUG [options]
  agentcoord release --repo REPO --slug SLUG [options]
  agentcoord sweep [--root DIR] [--stale-after-days DAYS] [--apply] [--json]
  agentcoord archive [--root DIR] [--older-than-days DAYS] [--apply] [--json]
  agentcoord handoff --repo REPO --slug SLUG --goal TEXT --state TEXT --next-action TEXT [options]

Options:
  --root DIR              AgentCoord root (default: $AGENTCOORD_ROOT or ${DEFAULT_ROOT})
  --agent NAME            Agent name (default: $AGENT_NAME or codex)
  --host NAME             Host name (default: local hostname)
  --safety VALUE          read, propose, or write (default: write for claim)
  --scope VALUE           Scope entry; repeatable
  --next-action TEXT      Next action text
  --ttl-hours HOURS       Expiry window for claim/renew (default: 2)
  --goal TEXT             Handoff goal
  --state TEXT            Handoff current state; repeatable
  --file VALUE            Handoff changed/owned file; repeatable
  --check VALUE           Handoff check and result; repeatable
  --blocker TEXT          Handoff blocker; repeatable
  --note TEXT             Handoff note; repeatable
  --stale-after-days DAYS For sweep: only release claims stale this many days (default: 7)
  --released-by NAME      For sweep: released_by metadata (default: agentcoord-janitor)
  --older-than-days DAYS  For archive: only move claims released this many days ago (default: 30)
  --apply                 For sweep/archive: write changes instead of dry-run
  --json                  Emit JSON

AgentCoord is a coordination hint layer for coding agents, not a lock service.`);
}

function parseArgs(argv) {
  const command = argv.shift() || "list";
  const args = {
    command,
    root: process.env.AGENTCOORD_ROOT || DEFAULT_ROOT,
    repo: "",
    slug: "",
    agent: process.env.AGENT_NAME || "codex",
    host: os.hostname().split(".")[0],
    safety: "write",
    scope: [],
    nextAction: "",
    ttlHours: 2,
    json: false,
    mode: "active",
    help: false,
    apply: false,
    staleAfterDays: 7,
    olderThanDays: 30,
    releasedBy: "agentcoord-janitor",
    goal: "",
    state: [],
    files: [],
    checks: [],
    blockers: [],
    notes: [],
  };

  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    const [rawKey, inlineValue] = arg.startsWith("--") ? arg.split(/=(.*)/s, 2) : [arg, undefined];
    const key = rawKey.replace(/^--/, "");

    if (arg === "-h" || arg === "--help") {
      args.help = true;
      continue;
    }
    if (["json", "all", "active", "stale", "invalid", "released", "apply"].includes(key)) {
      if (key === "json") args.json = true;
      else if (key === "apply") args.apply = true;
      else args.mode = key;
      continue;
    }

    const value = inlineValue !== undefined ? inlineValue : argv[++i];
    if (value === undefined) throw new Error(`${arg} requires a value`);

    if (key === "root") args.root = value;
    else if (key === "repo") args.repo = value;
    else if (key === "slug") args.slug = value;
    else if (key === "agent") args.agent = value;
    else if (key === "host") args.host = value;
    else if (key === "safety") args.safety = value;
    else if (key === "scope") args.scope.push(value);
    else if (key === "next-action") args.nextAction = value;
    else if (key === "ttl-hours") args.ttlHours = Number(value);
    else if (key === "stale-after-days") args.staleAfterDays = Number(value);
    else if (key === "older-than-days") args.olderThanDays = Number(value);
    else if (key === "released-by") args.releasedBy = value;
    else if (key === "goal") args.goal = value;
    else if (key === "state") args.state.push(value);
    else if (key === "file") args.files.push(value);
    else if (key === "check") args.checks.push(value);
    else if (key === "blocker") args.blockers.push(value);
    else if (key === "note") args.notes.push(value);
    else throw new Error(`unknown argument: ${arg}`);
  }
  if (args.command === "check") args.command = "validate";
  if (!Number.isFinite(args.staleAfterDays) || args.staleAfterDays < 0) throw new Error("--stale-after-days must be zero or positive");
  if (!Number.isFinite(args.olderThanDays) || args.olderThanDays < 0) throw new Error("--older-than-days must be zero or positive");
  return args;
}

function claimsRoot(root) { return path.join(root, "claims"); }
function archiveRoot(root) { return path.join(root, "claims-archive"); }
function handoffsRoot(root) { return path.join(root, "handoffs"); }
function tmpRoot(root) { return path.join(root, "tmp"); }

function safeSlug(value) {
  return String(value || "")
    .trim()
    .replace(/[^A-Za-z0-9._-]+/g, "-")
    .replace(/^-+|-+$/g, "") || "claim";
}

function repoParts(repo) {
  return String(repo || "misc").split(/[\\/]+/).filter(Boolean).map(safeSlug);
}

function repoDir(root, repo) { return path.join(claimsRoot(root), ...repoParts(repo)); }

function claimPath(root, claim) {
  const agent = safeSlug(claim.agent || "codex");
  const host = safeSlug(claim.host || os.hostname().split(".")[0]);
  return path.join(repoDir(root, claim.repo), `${safeSlug(claim.slug)}.${agent}.${host}.json`);
}

function matches(entry, args) {
  if (args.repo && normalizeRepo(entry.data?.repo) !== normalizeRepo(args.repo)) return false;
  if (args.mode === "all") return true;
  return entry.status === args.mode;
}

function renderList(entries, root = "") {
  if (!entries.length) return "agentcoord: no matching claims";
  return entries.map((entry) => {
    const data = entry.data || {};
    const file = root ? path.relative(root, entry.file) : entry.file;
    const issues = entry.issues?.length ? ` issues=${entry.issues.join("; ")}` : "";
    return [
      entry.status,
      data.repo || "unknown-repo",
      data.slug || path.basename(entry.file),
      data.agent || "unknown-agent",
      data.host || "unknown-host",
      data.safety || "unknown-safety",
      `expires=${normalizeTimestamp(data.expires_at)}`,
      `file=${file}`,
      `next=${data.next_action || ""}`,
      issues,
    ].filter(Boolean).join(" ");
  }).join("\n");
}

function summarize(entries) {
  const summary = { total: entries.length, active: 0, stale: 0, invalid: 0, released: 0 };
  for (const entry of entries) summary[entry.status] = (summary[entry.status] || 0) + 1;
  return summary;
}

function requireClaimArgs(args) {
  if (!args.repo) throw new Error("--repo is required");
  if (!args.slug) throw new Error("--slug is required");
  if (!Number.isFinite(args.ttlHours) || args.ttlHours <= 0) throw new Error("--ttl-hours must be positive");
  if (!SAFETY.has(args.safety)) throw new Error("--safety must be read, propose, or write");
}

function iso(date = new Date()) { return date.toISOString().replace(/\.\d{3}Z$/, "Z"); }

function atomicWrite(root, target, data) {
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.mkdirSync(tmpRoot(root), { recursive: true });
  const tmp = path.join(tmpRoot(root), `${path.basename(target)}.${process.pid}.${Date.now()}.tmp`);
  fs.writeFileSync(tmp, typeof data === "string" ? data : `${JSON.stringify(data, null, 2)}\n`);
  fs.renameSync(tmp, target);
}

function publicEntry(root, entry) {
  return { file: entry.file, relative_file: path.relative(root, entry.file), status: entry.status, issues: entry.issues, claim: entry.data };
}

function commandList(args) {
  const entries = readClaims(args.root).filter((entry) => matches(entry, args));
  if (args.json) console.log(JSON.stringify({ root: args.root, summary: summarize(entries), claims: entries.map((entry) => publicEntry(args.root, entry)) }, null, 2));
  else console.log(renderList(entries, args.root));
}

function commandValidate(args) {
  const entries = readClaims(args.root);
  const summary = summarize(entries);
  const invalid = entries.filter((entry) => entry.status === "invalid");
  if (args.json) console.log(JSON.stringify({ root: args.root, summary, invalid: invalid.map((entry) => publicEntry(args.root, entry)) }, null, 2));
  else {
    console.log(`agentcoord: root=${args.root}`);
    console.log(`agentcoord: total=${summary.total} active=${summary.active} stale=${summary.stale} released=${summary.released} invalid=${summary.invalid}`);
    if (invalid.length) console.log(renderList(invalid, args.root));
  }
  if (invalid.length) process.exitCode = 1;
}

function commandClaim(args) {
  requireClaimArgs(args);
  const now = new Date();
  const repo = normalizeRepo(args.repo);
  const claim = {
    repo,
    slug: args.slug,
    agent: args.agent,
    host: args.host,
    safety: args.safety,
    scope: args.scope.length ? args.scope : [repo],
    started_at: iso(now),
    expires_at: iso(new Date(now.getTime() + args.ttlHours * 3600000)),
    next_action: args.nextAction || "Claim created; update next_action before handoff.",
    contact: "Joel Kehle <joel@kehle.com>",
  };
  const serialized = prepareClaimForWrite(claim);
  const target = claimPath(args.root, claim);
  atomicWrite(args.root, target, serialized);
  if (args.json) console.log(JSON.stringify({ file: target, claim }, null, 2));
  else console.log(`agentcoord: claimed ${target}`);
}

function findExistingClaim(args) {
  if (!args.repo || !args.slug) throw new Error("--repo and --slug are required");
  const wanted = normalizeRepo(args.repo);
  const matches = readClaims(args.root).filter((entry) => {
    const data = entry.data || {};
    return normalizeRepo(data.repo) === wanted && data.slug === args.slug && (!args.agent || data.agent === args.agent) && (!args.host || data.host === args.host);
  });
  if (!matches.length) throw new Error(`claim not found: ${args.repo}/${args.slug}`);
  if (matches.length > 1) {
    matches.sort((a, b) => a.file.localeCompare(b.file));
    throw new Error(
      `ambiguous claim ${args.repo}/${args.slug}: ${matches.length} files match after repo normalization:\n` +
      matches.map((entry) => `  ${entry.file}`).join("\n") +
      "\nresolve by releasing or removing the duplicates, then retry",
    );
  }
  return matches[0];
}

function commandRenew(args) {
  if (!Number.isFinite(args.ttlHours) || args.ttlHours <= 0) throw new Error("--ttl-hours must be positive");
  const existing = findExistingClaim(args);
  const data = { ...existing.data, expires_at: iso(new Date(Date.now() + args.ttlHours * 3600000)) };
  if (args.nextAction) data.next_action = args.nextAction;
  delete data.released_at;
  atomicWrite(args.root, existing.file, data);
  if (args.json) console.log(JSON.stringify({ file: existing.file, claim: data }, null, 2));
  else console.log(`agentcoord: renewed ${existing.file}`);
}

function commandRelease(args) {
  const existing = findExistingClaim(args);
  const data = { ...existing.data, released_at: iso(new Date()) };
  if (args.nextAction) data.next_action = args.nextAction;
  atomicWrite(args.root, existing.file, data);
  if (args.json) console.log(JSON.stringify({ file: existing.file, claim: data }, null, 2));
  else console.log(`agentcoord: released ${existing.file}`);
}

function staleAgeDays(entry, now = new Date()) {
  if (!entry.expires) return 0;
  return Math.max(0, (now.getTime() - entry.expires.getTime()) / 86400000);
}

function fileAgeDays(file, now = new Date()) {
  return Math.max(0, (now.getTime() - fs.statSync(file).mtimeMs) / 86400000);
}

function janitorSummary({ entries, eligible, skippedRecent, released, invalid, invalidEligible, releasedInvalid, errors }) {
  return {
    stale: entries.length,
    eligible: eligible.length,
    skipped_recent: skippedRecent.length,
    released: released.length,
    invalid: invalid.length,
    invalid_eligible: invalidEligible.length,
    released_invalid: releasedInvalid.length,
    errors: errors.length,
  };
}

// A released tombstone for an invalid claim must itself be a fully valid
// claim, or every later read re-classifies it invalid and workspace
// preflight keeps blocking writes on agentcoord_claim_ambiguous. Synthesize
// required fields from the original where parseable, else use placeholders.
function invalidTombstone(entry, now, releasedBy) {
  const original = entry.data && typeof entry.data === "object" && !Array.isArray(entry.data)
    ? entry.data
    : null;
  const text = (value) => (typeof value === "string" && value.trim() ? value.trim() : "");
  const mtime = new Date(fs.statSync(entry.file).mtimeMs);
  const data = {
    repo: text(original?.repo) ? normalizeRepo(original.repo) : (entry.directory_repo || "unknown"),
    slug: text(original?.slug) || safeSlug(path.basename(entry.file, ".json")),
    agent: text(original?.agent) || "unknown",
    host: text(original?.host) || "unknown",
    safety: SAFETY.has(original?.safety) ? original.safety : "read",
    scope: Array.isArray(original?.scope) && original.scope.length ? original.scope : ["unknown"],
    started_at: parseTimestamp(original?.started_at) ? normalizeTimestamp(original.started_at) : iso(mtime),
    expires_at: parseTimestamp(original?.expires_at) ? normalizeTimestamp(original.expires_at) : iso(mtime),
    next_action: "released by janitor",
    released_at: iso(now),
    released_by: releasedBy,
    release_reason: "invalid-expired",
    previous_status: "invalid",
  };
  return { data, original };
}

function commandSweep(args) {
  const now = new Date();
  const entries = readClaims(args.root);
  const stale = entries.filter((entry) => entry.status === "stale");
  const invalid = entries.filter((entry) => entry.status === "invalid");
  const eligible = [];
  const skippedRecent = [];
  for (const entry of stale) {
    const age = staleAgeDays(entry, now);
    entry.stale_age_days = age;
    if (age >= args.staleAfterDays) eligible.push(entry);
    else skippedRecent.push(entry);
  }
  const invalidEligible = invalid.filter((entry) => {
    // A truthy but unparseable released_at does not count as released;
    // otherwise the claim escapes both this sweep and the archive tier.
    if (parseTimestamp(entry.data?.released_at)) return false;
    try {
      return fileAgeDays(entry.file, now) >= args.staleAfterDays;
    } catch {
      return false;
    }
  });
  const released = [];
  const releasedInvalid = [];
  const errors = [];
  if (args.apply) {
    for (const entry of eligible) {
      try {
        const age = staleAgeDays(entry, now);
        const data = {
          ...entry.data,
          released_at: iso(now),
          released_by: args.releasedBy,
          release_reason: `expired without renewal after ${age.toFixed(1)} day(s); threshold ${args.staleAfterDays} day(s)`,
          previous_status: "stale",
          stale_since: normalizeTimestamp(entry.data.expires_at),
        };
        atomicWrite(args.root, entry.file, data);
        const updated = readClaim(entry.file, {
          claimsRoot: claimsRoot(args.root),
          now,
        });
        updated.stale_age_days = age;
        released.push(updated);
      } catch (error) {
        errors.push({ file: entry.file, error: error.message });
      }
    }
    for (const entry of invalidEligible) {
      try {
        const { data, original } = invalidTombstone(entry, now, args.releasedBy);
        if (original !== null) {
          data.original = original;
        } else {
          const corrupt = `${entry.file}.corrupt`;
          fs.writeFileSync(corrupt, fs.readFileSync(entry.file));
          data.original_file = path.basename(corrupt);
        }
        atomicWrite(args.root, entry.file, prepareClaimForWrite(data));
        releasedInvalid.push(readClaim(entry.file, { claimsRoot: claimsRoot(args.root), now }));
      } catch (error) {
        errors.push({ file: entry.file, error: error.message });
      }
    }
  }
  const decorate = (entry) => ({ ...publicEntry(args.root, entry), stale_age_days: Number(staleAgeDays(entry, now).toFixed(3)) });
  const summary = janitorSummary({ entries: stale, eligible, skippedRecent, released, invalid, invalidEligible, releasedInvalid, errors });
  if (args.json) console.log(JSON.stringify({
    root: args.root,
    dry_run: !args.apply,
    apply: args.apply,
    stale_after_days: args.staleAfterDays,
    released_by: args.releasedBy,
    summary,
    stale: stale.map(decorate),
    eligible: eligible.map(decorate),
    skipped_recent: skippedRecent.map(decorate),
    invalid: invalid.map((entry) => publicEntry(args.root, entry)),
    invalid_eligible: invalidEligible.map((entry) => publicEntry(args.root, entry)),
    released: released.map((entry) => publicEntry(args.root, entry)),
    released_invalid: releasedInvalid.map((entry) => publicEntry(args.root, entry)),
    changed: [...released, ...releasedInvalid].map((entry) => publicEntry(args.root, entry)),
    errors,
  }, null, 2));
  else {
    console.log(`agentcoord: ${args.apply ? "janitor applied" : "janitor dry-run"} stale=${summary.stale} eligible=${summary.eligible} skipped_recent=${summary.skipped_recent} released=${summary.released} invalid=${summary.invalid} invalid_eligible=${summary.invalid_eligible} released_invalid=${summary.released_invalid} errors=${summary.errors} stale_after_days=${args.staleAfterDays}`);
    const shown = args.apply ? [...released, ...releasedInvalid] : [...eligible, ...invalidEligible];
    if (shown.length) console.log(renderList(shown, args.root));
    if (skippedRecent.length) console.log(`agentcoord: skipped ${skippedRecent.length} recent stale claim(s) below threshold`);
    if (errors.length) console.log(errors.map((error) => `agentcoord: error ${path.relative(args.root, error.file)} ${error.error}`).join("\n"));
  }
  if (errors.length) process.exitCode = 1;
}

function releasedAgeDays(entry, now = new Date()) {
  const released = parseTimestamp(entry.data?.released_at);
  if (!released) return null;
  return Math.max(0, (now.getTime() - released.getTime()) / 86400000);
}

function commandArchive(args) {
  const now = new Date();
  const entries = readClaims(args.root);
  const eligible = [];
  const skippedRecent = [];
  for (const entry of entries) {
    const age = releasedAgeDays(entry, now);
    if (age === null) continue;
    entry.released_age_days = age;
    if (age >= args.olderThanDays) eligible.push(entry);
    else skippedRecent.push(entry);
  }
  const archived = [];
  const errors = [];
  if (args.apply) {
    for (const entry of eligible) {
      try {
        const relative = path.relative(claimsRoot(args.root), entry.file);
        if (!relative || relative.startsWith("..") || path.isAbsolute(relative)) {
          throw new Error("claim file is outside the claims directory");
        }
        const targetDir = path.join(archiveRoot(args.root), path.dirname(relative));
        fs.mkdirSync(targetDir, { recursive: true });
        // Reused slug+agent+host after an earlier archive collides on the
        // same relative name. Suffix with released_at: deterministic and
        // collision-safe per release.
        const stamp = normalizeTimestamp(entry.data.released_at).replace(/:/g, "-");
        const baseName = path.basename(entry.file);
        let target = path.join(targetDir, baseName);
        if (fs.existsSync(target)) {
          target = path.join(targetDir, baseName.replace(/\.json$/, `.released-${stamp}.json`));
          if (fs.existsSync(target)) throw new Error(`archive target already exists: ${target}`);
        }
        // A corrupt-sidecar reference travels with its tombstone so the
        // evidence is not orphaned and original_file keeps resolving.
        const move = { from: entry.file, to: target };
        const sidecarName = typeof entry.data.original_file === "string"
          && entry.data.original_file
          && path.basename(entry.data.original_file) === entry.data.original_file
          ? entry.data.original_file
          : null;
        const sidecarSource = sidecarName ? path.join(path.dirname(entry.file), sidecarName) : null;
        if (sidecarSource && fs.existsSync(sidecarSource)) {
          let sidecarTargetName = sidecarName;
          let sidecarTarget = path.join(targetDir, sidecarTargetName);
          if (fs.existsSync(sidecarTarget)) {
            sidecarTargetName = `${sidecarName}.released-${stamp}`;
            sidecarTarget = path.join(targetDir, sidecarTargetName);
            if (fs.existsSync(sidecarTarget)) throw new Error(`archive target already exists: ${sidecarTarget}`);
            // Keep the tombstone's reference resolving after the rename.
            atomicWrite(args.root, entry.file, { ...entry.data, original_file: sidecarTargetName });
          }
          // Sidecar first: if the tombstone move then fails, a re-run still
          // finds the tombstone in claims/ and skips the moved sidecar.
          fs.renameSync(sidecarSource, sidecarTarget);
          move.sidecar_from = sidecarSource;
          move.sidecar_to = sidecarTarget;
        }
        fs.renameSync(entry.file, target);
        archived.push(move);
      } catch (error) {
        errors.push({ file: entry.file, error: error.message });
      }
    }
  }
  const decorate = (entry) => ({ ...publicEntry(args.root, entry), released_age_days: Number(entry.released_age_days.toFixed(3)) });
  const summary = {
    released: eligible.length + skippedRecent.length,
    eligible: eligible.length,
    skipped_recent: skippedRecent.length,
    archived: archived.length,
    errors: errors.length,
  };
  if (args.json) console.log(JSON.stringify({
    root: args.root,
    dry_run: !args.apply,
    apply: args.apply,
    older_than_days: args.olderThanDays,
    summary,
    eligible: eligible.map(decorate),
    skipped_recent: skippedRecent.map(decorate),
    archived,
    errors,
  }, null, 2));
  else {
    console.log(`agentcoord: ${args.apply ? "archive applied" : "archive dry-run"} released=${summary.released} eligible=${summary.eligible} skipped_recent=${summary.skipped_recent} archived=${summary.archived} errors=${summary.errors} older_than_days=${args.olderThanDays}`);
    if (args.apply) {
      if (archived.length) console.log(archived.map((move) => `agentcoord: archived ${path.relative(args.root, move.from)} -> ${path.relative(args.root, move.to)}`).join("\n"));
    } else if (eligible.length) {
      console.log(renderList(eligible, args.root));
    }
    if (errors.length) console.log(errors.map((error) => `agentcoord: error ${path.relative(args.root, error.file)} ${error.error}`).join("\n"));
  }
  if (errors.length) process.exitCode = 1;
}

function requireHandoffArgs(args) {
  if (!args.repo) throw new Error("--repo is required");
  if (!args.slug) throw new Error("--slug is required");
  if (!args.goal) throw new Error("--goal is required");
  if (!args.state.length) throw new Error("--state is required");
  if (!args.nextAction) throw new Error("--next-action is required");
}

function bullet(items, fallback = "None.") {
  if (!items.length) return fallback;
  return items.map((item) => `- ${item}`).join("\n");
}

function commandHandoff(args) {
  requireHandoffArgs(args);
  const stamp = iso(new Date()).replace(/[-:]/g, "").replace(/Z$/, "Z");
  const dir = path.join(handoffsRoot(args.root), ...repoParts(args.repo));
  const target = path.join(dir, `${safeSlug(args.slug)}-${stamp}.md`);
  const body = `# ${args.slug} handoff\n\n` +
    `- Repo: ${args.repo}\n` +
    `- Agent: ${args.agent}\n` +
    `- Host: ${args.host}\n` +
    `- Written: ${iso(new Date())}\n\n` +
    `## Goal\n\n${args.goal}\n\n` +
    `## Current State\n\n${bullet(args.state)}\n\n` +
    `## Files\n\n${bullet(args.files)}\n\n` +
    `## Checks\n\n${bullet(args.checks)}\n\n` +
    `## Blockers\n\n${bullet(args.blockers)}\n\n` +
    `## Notes\n\n${bullet(args.notes)}\n\n` +
    `## Next Action\n\n${args.nextAction}\n`;
  atomicWrite(args.root, target, body);
  if (args.json) console.log(JSON.stringify({ file: target }, null, 2));
  else console.log(`agentcoord: handoff ${target}`);
}

function main() {
  const args = parseArgs(process.argv.slice(2));
  if (args.help) return usage();
  if (args.command === "list") commandList(args);
  else if (args.command === "validate") commandValidate(args);
  else if (args.command === "claim") commandClaim(args);
  else if (args.command === "renew") commandRenew(args);
  else if (args.command === "release") commandRelease(args);
  else if (args.command === "sweep") commandSweep(args);
  else if (args.command === "archive") commandArchive(args);
  else if (args.command === "handoff") commandHandoff(args);
  else throw new Error(`unknown command: ${args.command}`);
}

try { main(); } catch (error) {
  console.error(`agentcoord: ${error.message}`);
  process.exit(1);
}

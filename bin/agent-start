#!/usr/bin/env node

const { spawnSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { relevantRunStates } = require("../lib/agent-workspace");
const { normalizeTimestamp } = require("../lib/agentcoord-claims");
const {
  DEFAULT_FOCUS_FILE,
  loadFocus,
  resolveGoal,
} = require("../lib/weekly-focus");
const {
  DEFAULT_AGENTCOORD_ROOT: PREFLIGHT_AGENTCOORD_ROOT,
  DEFAULT_QUARANTINE_ROOT,
  DEFAULT_STATE_ROOT,
  preflightWorkspace,
  publicPreflight,
} = require("../lib/workspace-preflight");

const DEFAULT_WORKBENCH_SUMMARY = process.env.AGENT_WORKBENCH_SUMMARY || "/home/joelkehle/Projects/shared/dev-dashboard/codex-output/agentic-software-ops/agent-workbench/latest/summary.json";
const DEFAULT_WORKBENCH_URL = process.env.AGENT_WORKBENCH_URL || "http://beelink:8091/codex-output/agentic-software-ops/agent-workbench/latest/";
const AGENTCOORD_TIMEOUT_FACTOR = 3;
const REQUIRED_TOOLS = ["agent-start", "agent-focus", "workspace-preflight", "agent-workspace", "agentcoord", "committer", "docs-list", "bus-discover", "claude", "codex", "agent-check"];

function usage() {
  console.log(`Usage: agent-start [--root DIR] [--mode read|write] [--session-kind repository|workspace] [--goal GOAL_ID]
                   [--focus-file PATH] [--json] [--notice] [--card PATH]
                   [--skip-bus|--no-bus] [--timeout MS]
                   [--workbench-summary PATH] [--workbench-url URL]

Prints a coding-agent launch packet: bus discovery, AgentCoord,
repo docs, git state, and validation entrypoint.

Use --notice from Codex/Claude launch wrappers. It reads the latest workbench
summary and prints a terminal-safe warning plus proof URL only when needed.`);
}

function parseArgs(argv) {
  const args = {
    root: process.cwd(),
    json: false,
    notice: false,
    cardPath: "",
    skipBus: false,
    timeoutMs: 5000,
    help: false,
    workbenchSummary: DEFAULT_WORKBENCH_SUMMARY,
    explicitWorkbenchSummary: Boolean(process.env.AGENT_WORKBENCH_SUMMARY),
    workbenchUrl: DEFAULT_WORKBENCH_URL,
    mode: "",
    sessionKind: "repository",
    sessionKindExplicit: false,
    goalId: process.env.AGENT_FOCUS_GOAL_ID || "",
    focusFile: DEFAULT_FOCUS_FILE,
    agentcoordRoot: PREFLIGHT_AGENTCOORD_ROOT,
    quarantineRoot: DEFAULT_QUARANTINE_ROOT,
    stateRoot: DEFAULT_STATE_ROOT,
  };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "--help" || arg === "-h") args.help = true;
    else if (arg === "--json") args.json = true;
    else if (arg === "--notice") args.notice = true;
    else if (arg === "--skip-bus" || arg === "--no-bus") args.skipBus = true;
    else if (arg === "--root") args.root = argv[++i];
    else if (arg === "--mode") args.mode = argv[++i];
    else if (arg === "--session-kind") {
      args.sessionKind = argv[++i];
      args.sessionKindExplicit = true;
    }
    else if (arg === "--goal") args.goalId = argv[++i];
    else if (arg === "--focus-file") args.focusFile = argv[++i];
    else if (arg === "--card") args.cardPath = argv[++i];
    else if (arg === "--timeout") args.timeoutMs = Number(argv[++i]);
    else if (arg === "--workbench-summary") {
      args.workbenchSummary = argv[++i];
      args.explicitWorkbenchSummary = true;
    }
    else if (arg === "--workbench-url") args.workbenchUrl = argv[++i];
    else throw new Error(`unknown argument: ${arg}`);
  }
  if (!Number.isFinite(args.timeoutMs) || args.timeoutMs <= 0) throw new Error("--timeout must be positive milliseconds");
  if (!["repository", "workspace"].includes(args.sessionKind)) throw new Error("--session-kind must be repository or workspace");
  args.root = path.resolve(args.root);
  if (!args.sessionKindExplicit && args.root === path.resolve(os.homedir(), "Projects")) {
    args.sessionKind = "workspace";
  }
  if (!args.mode) args.mode = args.sessionKind === "workspace" ? "read" : "write";
  if (!["read", "write"].includes(args.mode)) throw new Error("--mode must be read or write");
  if (args.sessionKind === "workspace" && args.mode !== "read") throw new Error("workspace sessions require --mode read");
  return args;
}

function run(command, args = [], options = {}) {
  const result = spawnSync(command, args, {
    cwd: options.cwd || process.cwd(),
    env: { ...process.env, ...(options.env || {}) },
    encoding: "utf8",
    timeout: options.timeoutMs || 5000,
    maxBuffer: 4 * 1024 * 1024,
  });
  return {
    command: [command, ...args].join(" "),
    status: result.status,
    signal: result.signal || null,
    error: result.error ? result.error.message : null,
    stdout: result.stdout || "",
    stderr: result.stderr || "",
  };
}

function lines(text) { return String(text || "").split("\n").filter(Boolean); }
function shellQuote(value) { return `'${String(value).replaceAll("'", `'\\''`)}'`; }

function commandExists(name) {
  const result = run("bash", ["-lc", `command -v ${shellQuote(name)}`], { timeoutMs: 1500 });
  return result.status === 0 ? result.stdout.trim() : "";
}

function gitRoot(start) {
  const result = run("git", ["-C", start, "rev-parse", "--show-toplevel"], { timeoutMs: 2000 });
  return result.status === 0 ? result.stdout.trim() : start;
}

function docsList(root, timeoutMs) {
  const result = run("docs-list", [root], { cwd: root, timeoutMs });
  if (result.status === 0) return { ok: true, output: result.stdout.trim(), command: result.command };
  const fallback = path.join(os.homedir(), "Projects/shared/agent-scripts/bin/docs-list");
  if (fs.existsSync(fallback)) {
    const retry = run(fallback, [root], { cwd: root, timeoutMs });
    return { ok: retry.status === 0, output: (retry.stdout || retry.stderr).trim(), command: retry.command };
  }
  return { ok: false, output: (result.stderr || result.error || "docs-list unavailable").trim(), command: result.command };
}

function busDiscovery(timeoutMs) {
  const primary = run("bus-discover", [], { timeoutMs });
  if (primary.status === 0 || primary.stdout) return primary;
  const fallback = path.join(os.homedir(), "Projects/shared/agent-scripts/bin/bus-discover");
  if (fs.existsSync(fallback)) return run(fallback, [], { timeoutMs });
  return primary;
}

function sectionFromCommand(title, result, maxLines = 80) {
  const output = lines(result.stdout || result.stderr || result.error || "").slice(0, maxLines);
  return { title, command: result.command, status: result.status, signal: result.signal, output };
}

function resolveAgentCoordCommand() {
  if (process.env.AGENTCOORD_BIN) return process.env.AGENTCOORD_BIN;
  const sibling = path.join(__dirname, "agentcoord");
  if (fs.existsSync(sibling)) return sibling;
  const installed = commandExists("agentcoord");
  if (installed) return installed;
  return path.join(os.homedir(), "Projects/shared/agent-scripts/bin/agentcoord");
}

function summarizeClaims(entries) {
  const summary = { total: entries.length, active: 0, stale: 0, invalid: 0, released: 0 };
  for (const entry of entries) summary[entry.status] += 1;
  return summary;
}

function collectAgentCoord(root, timeoutMs) {
  const command = resolveAgentCoordCommand();
  const result = run(command, ["list", "--root", root, "--all", "--json"], {
    timeoutMs: timeoutMs * AGENTCOORD_TIMEOUT_FACTOR,
    env: { UV_THREADPOOL_SIZE: "32" },
  });
  const failed = (message) => ({
    available: false,
    error: message,
    command: result.command,
    status: result.status,
    signal: result.signal,
    entries: [],
    summary: { total: 0, active: 0, stale: 0, invalid: 0, released: 0 },
  });
  if (result.status !== 0) {
    const detail = (result.stderr || result.error || (result.signal ? `terminated by ${result.signal}` : "unknown failure")).trim();
    return failed(detail || "claim scan failed without an error message");
  }
  let payload;
  try {
    payload = JSON.parse(result.stdout);
  } catch (error) {
    return failed(`claim scan returned invalid JSON: ${error.message}`);
  }
  if (!payload || !Array.isArray(payload.claims)) {
    return failed("claim scan response is missing claims");
  }
  const entries = [];
  for (const item of payload.claims) {
    if (!item || typeof item.file !== "string" || !["active", "stale", "invalid", "released"].includes(item.status)) {
      return failed("claim scan response contains an invalid claim entry");
    }
    entries.push({
      file: item.file,
      data: item.claim,
      directory_repo: item.directory_repo || "",
      status: item.status,
      issues: Array.isArray(item.issues) ? item.issues : [],
    });
  }
  return {
    available: true,
    error: null,
    command: result.command,
    status: result.status,
    signal: result.signal,
    entries,
    summary: summarizeClaims(entries),
  };
}

function renderClaims(entries, root) {
  if (!entries.length) return ["agentcoord: no matching claims"];
  return entries.map((entry) => {
    const data = entry.data || {};
    const issues = entry.issues.length ? ` issues=${entry.issues.join("; ")}` : "";
    return [
      entry.status,
      data.repo || "unknown-repo",
      data.slug || path.basename(entry.file),
      data.agent || "unknown-agent",
      data.host || "unknown-host",
      data.safety || "unknown-safety",
      `expires=${normalizeTimestamp(data.expires_at)}`,
      `file=${path.relative(root, entry.file)}`,
      `next=${data.next_action || ""}`,
      issues,
    ].filter(Boolean).join(" ");
  });
}

function agentCoordSections(claimState, root) {
  if (!claimState.available) {
    const section = (title) => ({
      title,
      command: claimState.command,
      status: 1,
      signal: claimState.signal,
      output: [`agentcoord: claim scan failed: ${claimState.error}`],
    });
    return [
      section("AgentCoord Validate"),
      section("AgentCoord Active Claims"),
      section("AgentCoord Stale Claims"),
    ];
  }
  const invalid = claimState.entries.filter((entry) => entry.status === "invalid");
  const active = claimState.entries.filter((entry) => entry.status === "active");
  const stale = claimState.entries.filter((entry) => entry.status === "stale");
  const summary = claimState.summary;
  const validateOutput = [
    `agentcoord: root=${root}`,
    `agentcoord: total=${summary.total} active=${summary.active} stale=${summary.stale} released=${summary.released} invalid=${summary.invalid}`,
  ];
  if (invalid.length) validateOutput.push(...renderClaims(invalid, root));
  return [
    { title: "AgentCoord Validate", command: claimState.command, status: invalid.length ? 1 : 0, signal: null, output: validateOutput },
    { title: "AgentCoord Active Claims", command: claimState.command, status: 0, signal: null, output: renderClaims(active, root) },
    { title: "AgentCoord Stale Claims", command: claimState.command, status: 0, signal: null, output: renderClaims(stale, root) },
  ];
}

function collectSshGrid(rawHost) {
  const gridPath = path.join(__dirname, "..", "lib", "ssh-grid.json");
  try {
    const grid = JSON.parse(fs.readFileSync(gridPath, "utf8"));
    // Normalize the real hostname (lowercase, drop any domain suffix), then
    // map real hostnames to grid names via hostAliases before the lookup.
    let host = String(rawHost).trim().toLowerCase().split(".")[0];
    const aliases = grid.hostAliases || {};
    if (Object.prototype.hasOwnProperty.call(aliases, host)) host = aliases[host];
    const hosts = grid.hosts || [];
    if (!hosts.includes(host)) {
      return { available: true, host, rawHost, known: false, allowed: [], blocked: hosts.slice(), rule: grid.rule, error: null };
    }
    const row = (grid.grid && grid.grid[host]) || {};
    const allowed = Object.entries(row).map(([target, cell]) => ({
      target,
      method: cell.method,
      command: cell.command,
      note: cell.note || null,
    }));
    const blocked = hosts.filter((name) => name !== host && !row[name]);
    return { available: true, host, rawHost, known: true, allowed, blocked, rule: grid.rule, error: null };
  } catch (error) {
    return { available: false, host: rawHost, rawHost, known: false, allowed: [], blocked: [], rule: null, error: error.message };
  }
}

function renderSshGrid(sshGrid) {
  const out = ["== SSH Grid =="];
  if (!sshGrid.available) {
    out.push(`grid unavailable: ${sshGrid.error}`);
    return out;
  }
  if (sshGrid.known === false) {
    out.push(`This machine's hostname '${sshGrid.rawHost}' is not in the SSH grid, so all SSH is blocked.`);
    out.push("If it is a known machine, add its lowercase hostname to hostAliases in lib/ssh-grid.json.");
    out.push(sshGrid.rule || "Use the current helper's normal SSH identity. Never copy or print private keys.");
    return out;
  }
  if (!sshGrid.allowed.length) {
    out.push(`From ${sshGrid.host}, agents may not SSH to any other machine.`);
  } else {
    for (const cell of sshGrid.allowed) {
      const how = cell.command ? `run \`${cell.command}\`` : cell.note || cell.method;
      out.push(`From ${sshGrid.host} you may reach ${cell.target}: ${how}.`);
    }
  }
  if (sshGrid.blocked.length) out.push(`Blocked from ${sshGrid.host}: ${sshGrid.blocked.join(", ")}.`);
  out.push(sshGrid.rule || "Use the current helper's normal SSH identity. Never copy or print private keys.");
  return out.slice(0, 8);
}

function normalizeWorkbenchPayload(payload) {
  const summary = payload && payload.summary ? payload.summary : payload;
  const artifacts = payload && payload.artifacts ? payload.artifacts : {};
  return { summary: summary || {}, artifacts };
}

function readWorkbenchSummary(summaryPath, proofUrl, explicitSummary = false) {
  const resolvedPath = path.resolve(summaryPath);
  try {
    const raw = fs.readFileSync(resolvedPath, "utf8");
    const { summary, artifacts } = normalizeWorkbenchPayload(JSON.parse(raw));
    const url = artifacts.latestUrl || proofUrl;
    return {
      available: true,
      path: resolvedPath,
      url,
      label: summary.label || "Coding-agent workbench",
      timestamp: summary.timestamp || null,
      shouldSurface: Boolean(summary.shouldSurface),
      surfaceReasons: Array.isArray(summary.surfaceReasons) ? summary.surfaceReasons : [],
      counts: summary.counts || {},
    };
  } catch (error) {
    const shouldSurface = explicitSummary || os.hostname().split(".")[0] === "beelink";
    return {
      available: false,
      path: resolvedPath,
      url: proofUrl,
      label: "Coding-agent workbench",
      timestamp: null,
      shouldSurface,
      surfaceReasons: shouldSurface ? [`workbench summary unavailable: ${error.message}`] : [],
      counts: {},
    };
  }
}

function workbenchReasons(workbench) {
  if (!workbench.available) return workbench.surfaceReasons;
  if (!workbench.shouldSurface) return [];
  if (workbench.surfaceReasons.length) return workbench.surfaceReasons;
  return ["workbench requested Joel attention"];
}

function buildSurface(packet) {
  const reasons = [];
  for (const [tool, location] of Object.entries(packet.tools)) {
    if (!location) reasons.push(`missing tool: ${tool}`);
  }
  for (const section of packet.results) {
    if (["AgentCoord Validate", "Docs", "Validation Entrypoint"].includes(section.title) && section.status !== 0) {
      reasons.push(`${section.title} failed: ${section.command}`);
    }
  }
  if (packet.workbench) reasons.push(...workbenchReasons(packet.workbench));
  if (packet.sshGrid && !packet.sshGrid.available) {
    reasons.push(`ssh grid unavailable: ${packet.sshGrid.error}`);
  }
  if (!packet.weeklyFocus.ok) reasons.push(`weekly focus invalid: ${packet.weeklyFocus.error}`);
  if (packet.workspacePreflight.shouldSurface) {
    reasons.push(...packet.workspacePreflight.issues.map((item) => `${item.code}: ${item.message}`));
  }
  packet.surfaceReasons = reasons;
  packet.shouldSurface = reasons.length > 0;
}

function collectWeeklyFocus(args) {
  try {
    const focus = loadFocus(args.focusFile, { allowExpired: true });
    const selected = args.goalId ? resolveGoal(focus, args.goalId) : null;
    return {
      ok: !focus.expired,
      file: focus.file,
      schema: focus.schema || null,
      week_ending: focus.week_ending,
      status: focus.status,
      expired: focus.expired,
      current_date: focus.current_date,
      time_zone: focus.time_zone,
      goals: focus.goals,
      selected,
      not_this_week: focus.not_this_week,
      error: focus.expired
        ? `week_ending ${focus.week_ending} expired in ${focus.time_zone}; current date is ${focus.current_date}`
        : null,
    };
  } catch (error) {
    return {
      ok: false,
      file: args.focusFile,
      schema: null,
      week_ending: null,
      status: "invalid",
      expired: false,
      current_date: null,
      time_zone: "America/Los_Angeles",
      goals: [],
      selected: null,
      not_this_week: [],
      error: error.message,
    };
  }
}

function collectSafety(args, root, claimState) {
  const weeklyFocus = collectWeeklyFocus(args);
  const workspacePreflight = publicPreflight(preflightWorkspace(root, args.mode, {
    agentcoordRoot: args.agentcoordRoot,
    quarantineRoot: args.quarantineRoot,
    stateRoot: args.stateRoot,
    sessionKind: args.sessionKind,
    ...(claimState.available
      ? { claimEntries: claimState.entries }
      : { claimStateError: claimState.error }),
  }));
  const runStates = relevantRunStates(root, { stateRoot: args.stateRoot });
  return { weeklyFocus, workspacePreflight, runStates };
}

function collect(args) {
  const root = args.sessionKind === "workspace" ? path.resolve(args.root) : gitRoot(args.root);
  const claimState = collectAgentCoord(args.agentcoordRoot, args.timeoutMs);
  const packet = {
    label: "Coding-agent startup brief",
    safetyClass: "read",
    generated_at: new Date().toISOString().replace(/\.\d{3}Z$/, "Z"),
    host: os.hostname().split(".")[0],
    cwd: process.cwd(),
    root,
    sessionKindExplicit: args.sessionKindExplicit === true,
    tools: Object.fromEntries(REQUIRED_TOOLS.map((tool) => [tool, commandExists(tool) || null])),
    workbench: readWorkbenchSummary(args.workbenchSummary, args.workbenchUrl, args.explicitWorkbenchSummary),
    sshGrid: collectSshGrid(os.hostname()),
    shouldSurface: false,
    surfaceReasons: [],
    results: [],
    agentCoord: {
      available: claimState.available,
      error: claimState.error,
      command: claimState.command,
      summary: claimState.summary,
    },
    ...collectSafety(args, root, claimState),
  };
  if (!args.skipBus) packet.results.push(sectionFromCommand("Bus Discovery", busDiscovery(Math.max(args.timeoutMs, 8000)), 120));
  packet.results.push(...agentCoordSections(claimState, args.agentcoordRoot));
  const docs = docsList(root, args.timeoutMs);
  packet.results.push({ title: "Docs", command: docs.command || "docs-list", status: docs.ok ? 0 : 1, signal: null, output: lines(docs.output).slice(0, 120) });
  if (args.sessionKind === "workspace") {
    packet.results.push({
      title: "Git Status",
      command: "not applicable for a cross-repository workspace root",
      status: 0,
      signal: null,
      output: ["Run Git checks inside the repository being changed."],
    });
    packet.results.push({
      title: "Validation Entrypoint",
      command: "not applicable for a cross-repository workspace root",
      status: 0,
      signal: null,
      output: ["Run agent-check inside the repository being changed."],
    });
  } else {
    packet.results.push(sectionFromCommand("Git Status", run("git", ["-C", root, "status", "--short", "--branch"], { timeoutMs: args.timeoutMs }), 80));
    packet.results.push(sectionFromCommand("Validation Entrypoint", run("agent-check", ["--root", root, "--dry-run"], { cwd: root, timeoutMs: args.timeoutMs }), 20));
  }
  buildSurface(packet);
  return packet;
}

function safetyReasons(safety) {
  const reasons = [];
  if (!safety.weeklyFocus.ok) reasons.push(`weekly focus invalid: ${safety.weeklyFocus.error}`);
  if (safety.workspacePreflight.shouldSurface) {
    reasons.push(...safety.workspacePreflight.issues.map((item) => `${item.code}: ${item.message}`));
  }
  return reasons;
}

function renderNotice(workbench, safety) {
  const reasons = [...workbenchReasons(workbench), ...safetyReasons(safety)];
  if (!reasons.length) return "";
  const headline = reasons.length === 1 ? reasons[0] : `${reasons.length} issues`;
  const out = [`Agent workbench warning: ${headline}`];
  for (const reason of reasons.slice(0, 5)) out.push(`- ${reason}`);
  if (reasons.length > 5) out.push(`- ${reasons.length - 5} more`);
  out.push(`Proof: ${workbench.url}`);
  return `${out.join("\n")}\n`;
}

function renderText(packet) {
  const out = [];
  out.push("Agent Start");
  out.push(`host=${packet.host}`);
  out.push(`root=${packet.root}`);
  out.push(`generated=${packet.generated_at}`);
  out.push(`shouldSurface=${packet.shouldSurface}`);
  if (packet.surfaceReasons.length) {
    out.push("surfaceReasons:");
    out.push(...packet.surfaceReasons.map((reason) => `- ${reason}`));
  }
  out.push("");
  out.push("== Weekly Focus ==");
  if (!packet.weeklyFocus.ok) {
    out.push(`INVALID ${packet.weeklyFocus.error}`);
  } else {
    out.push(`schema: ${packet.weeklyFocus.schema || "legacy"}`);
    out.push(`week ending: ${packet.weeklyFocus.week_ending}`);
    for (const goal of packet.weeklyFocus.goals) {
      const selected = packet.weeklyFocus.selected?.goal_id === goal.id ? " [selected]" : "";
      out.push(`goal: ${goal.id}${selected}`);
      out.push(`  definition of done: ${goal.done}`);
      out.push(`  required milestone: ${goal.required_milestone}`);
      for (const ref of goal.execution_refs || []) {
        out.push(`  legacy execution reference: ${ref.kind}:${ref.id}`);
      }
      if (goal.active_execution_ref) {
        out.push(`  active execution binding: ${goal.active_execution_ref.kind}:${goal.active_execution_ref.id}`);
      }
      for (const ref of goal.proof_execution_refs || []) {
        out.push(`  proof execution reference: ${ref.kind}:${ref.id}`);
      }
      if (goal.supervised_execution) {
        out.push(`  supervision required: ${goal.supervised_execution.required}`);
      }
    }
  }
  out.push("");
  out.push("== Workspace Safety ==");
  out.push(`preflight: ${packet.workspacePreflight.ok ? "PASS" : "REFUSE"} mode=${packet.workspacePreflight.mode}`);
  out.push(`session: ${packet.workspacePreflight.session_kind || "unavailable"}`);
  if (packet.workspacePreflight.session_kind === "workspace") {
    if (process.env.AGENT_LAUNCH_SUPERVISED === "1" || packet.sessionKindExplicit) {
      out.push("authority: operator safety=read (no code-write authority)");
    } else {
      out.push("authority: unsupervised session; no supervised authority claims, normal tool permissions apply");
    }
  } else {
    out.push(`origin fetch: ${packet.workspacePreflight.origin_fetch_url || "(unavailable)"}`);
    out.push(`origin push: ${packet.workspacePreflight.origin_push_urls.length ? packet.workspacePreflight.origin_push_urls.join(", ") : "(unavailable)"}`);
  }
  if (packet.workspacePreflight.shouldSurface) {
    for (const item of packet.workspacePreflight.issues) out.push(`- ${item.code}: ${item.message}`);
  }
  if (packet.runStates.length) {
    out.push("runs:");
    for (const run of packet.runStates) {
      const binding = run.execution_ref ? ` execution=${run.execution_ref.kind}:${run.execution_ref.id}` : "";
      out.push(`- ${run.state} ${run.run_id} tool=${run.tool}${binding}`);
      if (run.quarantine_reason) out.push(`  quarantine: ${run.quarantine_reason}`);
    }
  }
  out.push("");
  out.push(...renderSshGrid(packet.sshGrid));
  out.push("");
  out.push("== Workbench ==");
  out.push(`summary: ${packet.workbench.path}`);
  out.push(`available: ${packet.workbench.available}`);
  out.push(`shouldSurface: ${packet.workbench.shouldSurface}`);
  out.push(`proof: ${packet.workbench.url}`);
  if (packet.workbench.surfaceReasons.length) {
    out.push("surfaceReasons:");
    out.push(...packet.workbench.surfaceReasons.map((reason) => `- ${reason}`));
  }
  out.push("");
  out.push("== Tool Visibility ==");
  for (const [tool, location] of Object.entries(packet.tools)) out.push(`${location ? "OK" : "MISSING"} ${tool}${location ? ` -> ${location}` : ""}`);
  for (const section of packet.results) {
    out.push("");
    out.push(`== ${section.title} ==`);
    out.push(`command: ${section.command}`);
    out.push(`status: ${section.status}${section.signal ? ` signal=${section.signal}` : ""}`);
    if (!section.output.length) out.push("(no output)");
    else out.push(...section.output);
  }
  return `${out.join("\n")}\n`;
}

function writeCard(file, packet) {
  fs.mkdirSync(path.dirname(path.resolve(file)), { recursive: true });
  fs.writeFileSync(file, `${JSON.stringify(packet, null, 2)}\n`);
}

try {
  const args = parseArgs(process.argv.slice(2));
  if (args.help) {
    usage();
    process.exit(0);
  }
  if (args.notice) {
    const root = args.sessionKind === "workspace" ? path.resolve(args.root) : gitRoot(args.root);
    const claimState = collectAgentCoord(args.agentcoordRoot, args.timeoutMs);
    const safety = collectSafety(args, root, claimState);
    process.stdout.write(renderNotice(
      readWorkbenchSummary(args.workbenchSummary, args.workbenchUrl, args.explicitWorkbenchSummary),
      safety,
    ));
    process.exit(claimState.available ? 0 : 1);
  }
  const packet = collect(args);
  if (args.cardPath) writeCard(args.cardPath, packet);
  if (args.json) console.log(JSON.stringify(packet, null, 2));
  else process.stdout.write(renderText(packet));
  if (!packet.agentCoord.available) process.exitCode = 1;
} catch (error) {
  console.error(`agent-start: ${error.message}`);
  process.exit(1);
}

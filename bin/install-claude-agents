#!/usr/bin/env bash
set -euo pipefail

# install-claude-agents — symlink canonical Claude Code agent definitions
# (claude/agents/*.md) into ~/.claude/agents so every lane on this machine
# resolves the tracked versions. Idempotent. Refuses to overwrite a divergent
# regular file; replaces an identical regular file with a symlink.

# Resolve the real script location through installer shims (agent-env-install
# links this file into a prefix such as /usr/local/bin).
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  self_dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
src_dir="$(cd -P "$(dirname "$self")/../claude/agents" && pwd)"
dst_dir="${CLAUDE_AGENTS_DIR:-$HOME/.claude/agents}"
mkdir -p "$dst_dir"

# Only git-tracked definitions are installable: a stray untracked file in
# claude/agents/ must not become a globally resolved agent. Fails closed if
# the tracked set cannot be enumerated.
repo_dir="$(cd -P "$src_dir/../.." && pwd)"
tracked=$(git -C "$repo_dir" ls-files 'claude/agents/*.md' 2>/dev/null) || tracked=""
if [ -z "$tracked" ]; then
  printf 'install-claude-agents: cannot enumerate tracked agent definitions in %s; refusing\n' "$repo_dir" >&2
  exit 1
fi
is_tracked() { printf '%s\n' "$tracked" | grep -qxF "claude/agents/$1"; }

status=0
for src in "$src_dir"/*.md; do
  name=$(basename "$src")
  if ! is_tracked "$name"; then
    printf 'install-claude-agents: skipping untracked %s\n' "$name" >&2
    continue
  fi
  dst="$dst_dir/$name"
  if [ -L "$dst" ]; then
    ln -sfn "$src" "$dst"
    printf 'install-claude-agents: linked %s\n' "$name"
  elif [ -e "$dst" ]; then
    if cmp -s "$src" "$dst"; then
      ln -sfn "$src" "$dst"
      printf 'install-claude-agents: replaced identical file %s with link\n' "$name"
    else
      printf 'install-claude-agents: REFUSING %s — existing file diverges from tracked copy.\n' "$name" >&2
      printf '  local:   %s\n  tracked: %s\n  Reconcile manually, then re-run.\n' "$dst" "$src" >&2
      status=1
    fi
  else
    ln -s "$src" "$dst"
    printf 'install-claude-agents: installed %s\n' "$name"
  fi
done
exit "$status"

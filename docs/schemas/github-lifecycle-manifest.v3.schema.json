{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joelkehle.com/schemas/github-lifecycle-manifest.v3.schema.json",
  "title": "GitHub lifecycle specification-to-issue manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_version",
    "specification",
    "requirements",
    "issues",
    "weekly_goal"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "github-lifecycle-manifest.v3"
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "specification": {
      "title": "Source specification",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_id",
        "source_revision",
        "source_document"
      ],
      "properties": {
        "spec_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^\\S+$"
        },
        "source_document": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "ratified_on": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "title": "Requirement",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "normative": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "title": "Proposed issue",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "title",
          "owner_repository",
          "requirements",
          "depends_on",
          "acceptance_criteria",
          "validation_commands",
          "non_goals",
          "write_class",
          "definition_of_done"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "owner_repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
            },
            "minItems": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "validation_commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "non_goals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "write_class": {
            "type": "string",
            "enum": [
              "read",
              "propose",
              "write"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "manager_project": {
            "type": "string",
            "minLength": 1
          },
          "external_dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation_notes": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "definition_of_done": {
            "title": "Definition of done",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "proof_requirements",
              "pass_criteria",
              "non_goals",
              "budget",
              "kill_criteria",
              "defer_policy",
              "ratification",
              "finding_policy"
            ],
            "properties": {
              "class": {
                "type": "string",
                "enum": [
                  "full",
                  "lightweight"
                ]
              },
              "proof_requirements": {
                "type": "array",
                "items": {
                  "title": "Proof requirement",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "requirement",
                    "evidence"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
                    },
                    "requirement": {
                      "type": "string",
                      "pattern": "\\S",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "string",
                      "pattern": "\\S",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              },
              "pass_criteria": {
                "type": "array",
                "items": {
                  "title": "Pass criterion",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "proof_id",
                    "criterion",
                    "expected_result"
                  ],
                  "properties": {
                    "proof_id": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
                    },
                    "criterion": {
                      "type": "string",
                      "pattern": "\\S",
                      "minLength": 1
                    },
                    "expected_result": {
                      "type": "string",
                      "pattern": "\\S",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              },
              "non_goals": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "budget": {
                "title": "Review and continuation budget",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "max_review_rounds",
                  "max_continuation_attempts"
                ],
                "properties": {
                  "max_review_rounds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_continuation_attempts": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "kill_criteria": {
                "type": "array",
                "items": {
                  "title": "Kill criterion",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "trigger",
                    "action",
                    "decide_by"
                  ],
                  "properties": {
                    "trigger": {
                      "type": "string",
                      "pattern": "\\S",
                      "minLength": 1
                    },
                    "action": {
                      "type": "string",
                      "pattern": "\\S",
                      "minLength": 1
                    },
                    "decide_by": {
                      "type": "string",
                      "pattern": "\\S",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              },
              "defer_policy": {
                "title": "Deferral destination and promotion rule",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "destination",
                  "promotion_rule"
                ],
                "properties": {
                  "destination": {
                    "type": "string",
                    "pattern": "\\S",
                    "minLength": 1
                  },
                  "promotion_rule": {
                    "type": "string",
                    "pattern": "\\S",
                    "minLength": 1
                  }
                }
              },
              "ratification": {
                "title": "Human ratification evidence policy",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "actor",
                  "evidence"
                ],
                "properties": {
                  "actor": {
                    "type": "string",
                    "const": "joelkehle"
                  },
                  "evidence": {
                    "type": "string",
                    "const": "github_comment"
                  }
                }
              },
              "finding_policy": {
                "title": "Finding disposition policy",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "within_dod",
                  "beyond_dod",
                  "contract_gap",
                  "at_budget"
                ],
                "properties": {
                  "within_dod": {
                    "type": "string",
                    "const": "fix"
                  },
                  "beyond_dod": {
                    "type": "string",
                    "const": "defer"
                  },
                  "contract_gap": {
                    "type": "string",
                    "const": "escalate"
                  },
                  "at_budget": {
                    "type": "string",
                    "const": "accept_or_defer"
                  }
                }
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "weekly_goal": {
      "title": "Weekly goal link",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "goal_id",
        "week_ending"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "const": "agentcoord-weekly-goal-link.v1"
        },
        "goal_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
        },
        "week_ending": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}

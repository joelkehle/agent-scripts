{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joelkehle.com/schemas/github-lifecycle-manifest.v1.schema.json",
  "title": "GitHub lifecycle specification-to-issue manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_version",
    "specification",
    "requirements",
    "issues"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "github-lifecycle-manifest.v1"
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "specification": {
      "title": "Source specification",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_id",
        "source_revision",
        "source_document"
      ],
      "properties": {
        "spec_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^\\S+$"
        },
        "source_document": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "ratified_on": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "title": "Requirement",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "normative": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "title": "Proposed issue",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "title",
          "owner_repository",
          "requirements",
          "depends_on",
          "acceptance_criteria",
          "validation_commands",
          "non_goals",
          "write_class"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "owner_repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
            },
            "minItems": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "validation_commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "non_goals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "write_class": {
            "type": "string",
            "enum": [
              "read",
              "propose",
              "write"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "manager_project": {
            "type": "string",
            "minLength": 1
          },
          "external_dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation_notes": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "minItems": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
